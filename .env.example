# Copie para .env (que NAO vai para o git) e preencha as senhas.

# Conta do Docker Hub onde a Action publica as imagens (o mesmo valor do secret
# DOCKERHUB_USERNAME no GitHub). A EC2 baixa daqui progest-api e progest-frontend.
DOCKERHUB_USUARIO=
# Versao das imagens: latest (a ultima da main) ou uma anterior, ex.: v42
VERSAO=latest

# A senha do banco e fixada quando o banco e criado pela primeira vez; depois nao a altere.
DB_PASSWORD=troque-esta-senha

# Administrador do painel de gestao (ERP). Minimo de 8 caracteres.
# A cada inicio o backend garante que este usuario exista com esta senha:
# para trocar a senha, mude aqui e rode "docker compose up -d".
ADMIN_EMAIL=amaralalambrados109@gmail.com
ADMIN_NOME=Administrador
ADMIN_SENHA=troque-esta-senha-do-erp

# Funcionario do ERP (opcional): so ve a tela Producao e Entregas.
# Mesma regra do administrador: criado/atualizado a cada inicio. Minimo de 8 caracteres.
FUNCIONARIO_EMAIL=
FUNCIONARIO_NOME=Funcionário
FUNCIONARIO_SENHA=

# Dados ficticios para apresentacao (clientes, pedidos e financeiro de exemplo).
# Rodam uma vez so por banco. DEMO_SENHA (opcional, minimo 8): senha dos clientes de exemplo no site.
DEMO_DADOS=false
DEMO_SENHA=
