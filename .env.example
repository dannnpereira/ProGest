# Copie para .env (que NAO vai para o git) e troque as senhas.
# A senha e fixada quando o banco e criado pela primeira vez; depois disso nao a altere aqui.
DB_PASSWORD=troque-esta-senha

# Primeiro usuario do painel de gestao (ERP), criado na primeira vez que o backend sobe.
# Minimo de 8 caracteres. Depois de criado, mudar aqui NAO altera a senha.
ADMIN_EMAIL=admin@amaral.com.br
ADMIN_NOME=Administrador
ADMIN_SENHA=troque-esta-senha-do-erp
