@startuml casos-de-uso-uml-erp
!pragma layout elk
left to right direction
skinparam defaultFontName Arial
skinparam packageStyle rectangle
skinparam usecase {
  BackgroundColor #F4F5F7
  BorderColor #4B5563
  BackgroundColor<<proposto>> #FFF8E6
  BorderColor<<proposto>> #D97706
}
title Casos de uso — Painel ProGest (ERP)

actor "Funcionário" as Funcionario
actor Administrador
actor "ViaCEP" as ViaCEP <<sistema externo>>
actor "WhatsApp" as WhatsApp <<sistema externo>>

Administrador -|> Funcionario

rectangle "Painel ProGest (ERP)" {
  rectangle "Operação" {
    usecase "UC10 Entrar no painel" as UC10
    usecase "UC11 Avançar ou voltar\netapa da produção" as UC11
    usecase "UC12 Aprovar pedido\n(individual ou em lote)" as UC12
    usecase "UC13 Recusar pedido\ncom motivo" as UC13
    usecase "UC14 Ver prévia técnica\ne memorial" as UC14
    usecase "UC15 Conversar com\no cliente" as UC15
  }
  rectangle "Comercial e cadastros" {
    usecase "UC16 Criar orçamento\nno ERP" as UC16
    usecase "UC17 Buscar cliente\npor CPF" as UC17
    usecase "UC18 Cadastrar conta\ndo cliente" as UC18
    usecase "UC19 Gerenciar produtos" as UC19
    usecase "UC20 Gerenciar tabela\nde preços" as UC20
    usecase "UC21 Definir regras\ndo orçamento" as UC21
    usecase "UC28 Consultar clientes" as UC28 <<proposto>>
    usecase "UC29 Gerar link de\nnova senha do cliente" as UC29
  }
  rectangle "Financeiro e administração" {
    usecase "UC22 Registrar ou\nestornar pagamento" as UC22
    usecase "UC23 Registrar compras\ne saídas" as UC23
    usecase "UC24 Consultar caixa e\ncomparativo mensal" as UC24
    usecase "UC25 Configurar dados\nda empresa" as UC25
    usecase "UC26 Controlar estoque\nde arames" as UC26 <<proposto>>
    usecase "UC27 Gerenciar usuários\ndo painel" as UC27 <<proposto>>
  }
}

Funcionario --> UC10
Funcionario --> UC11
Administrador --> UC12
Administrador --> UC13
Administrador --> UC16
Administrador --> UC19
Administrador --> UC20
Administrador --> UC21
Administrador --> UC28
Administrador --> UC29
Administrador --> UC22
Administrador --> UC23
Administrador --> UC24
Administrador --> UC25
Administrador --> UC26
Administrador --> UC27

UC14 ..> UC12 : <<extend>>
UC15 ..> UC12 : <<extend>>
UC17 ..> UC16 : <<extend>>
UC18 ..> UC17 : <<extend>>
UC15 --> WhatsApp
UC16 --> ViaCEP
@enduml
